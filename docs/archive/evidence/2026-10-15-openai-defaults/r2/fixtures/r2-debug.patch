diff --git a/internal/cost/cost.go b/internal/cost/cost.go
index a36f4b1..0cf6506 100644
--- a/internal/cost/cost.go
+++ b/internal/cost/cost.go
@@ -52,7 +52,7 @@ func (l *Ledger) Observe(thread, model string, u responses.Usage, at time.Time)
 		l.threads[thread] = t
 	}
 	t.current = model
-	t.models[model] = CacheState{PrefixTokens: u.InputTokens, LastAt: at}
+	t.models[model] = CacheState{PrefixTokens: u.InputTokens - u.CachedInputTokens, LastAt: at}
 }
 
 // SwitchTax is how many more uncached input tokens the thread's next request,
diff --git a/internal/policy/policy.go b/internal/policy/policy.go
index 2ad55d1..e2ef58f 100644
--- a/internal/policy/policy.go
+++ b/internal/policy/policy.go
@@ -113,7 +113,7 @@ func Decide(in Input) Result {
 		}
 		if target, ok := escalate(incumbent); ok {
 			next.EscalatedSignature = in.FailureSignature
-			next.HoldUntilTurn = next.Turn + p.EscalationHoldTurns
+			next.HoldUntilTurn = next.Turn + p.EscalationHoldTurns - 1
 			next.Votes = nil
 			return Result{Tier: target, Reason: ReasonEscalation, State: next}
 		}
